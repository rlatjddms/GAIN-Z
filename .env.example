# docker compose 용 설정 (#176). 이 파일을 .env 로 복사해서 채운다. .env 는 .gitignore 에 있어 커밋되지 않는다.
# 로컬 개발(gradlew bootRun / npm run dev)에서는 이 파일을 쓰지 않는다 → backend/src/main/resources/application-secret.yml, frontend/.env

# --- 필수 ---
DB_PASSWORD=
# HMAC-SHA256 서명 키, 32자 이상
JWT_SECRET=
# 브라우저가 접속하는 주소 (끝에 / 없이). 포트를 바꿨으면 그 포트까지. 예) https://gainz.example.com
FRONTEND_URL=http://localhost
# 소셜 로그인 콘솔에 등록한 값. 콘솔의 리다이렉트 URI는 ${FRONTEND_URL}/login/oauth2/code/{google|kakao|naver}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 선택 ---
# DB_USERNAME=gainz
# 프론트를 열 호스트 포트 (기본 80)
# WEB_PORT=80
# CORS 허용 출처를 여러 개 두려면 쉼표로. 기본은 FRONTEND_URL 하나
# ALLOWED_ORIGINS=
# 프론트가 다른 도메인의 백엔드를 부를 때만. 비우면 같은 도메인
# VITE_API_BASE_URL=
# 첫 실행(테이블 생성) 때만 update, 그 뒤엔 지우거나 validate
# DDL_AUTO=update
# 운영에서 API 문서를 보려면 true
# SWAGGER_ENABLED=false
# 올린 파일을 Supabase Storage(비공개 버킷)에 두려면. 기본 local = uploads 볼륨
# STORAGE_TYPE=supabase
# SUPABASE_URL=https://<프로젝트>.supabase.co
# SUPABASE_BUCKET=uploads
# SUPABASE_SERVICE_KEY=

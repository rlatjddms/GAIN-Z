# 로컬 개발용 비밀값 예시 (#174).
# 이 파일을 같은 폴더에 application-secret.yml 로 복사하고 값을 채운다. application-secret.yml은 .gitignore에 있어 커밋되지 않는다.
# 소셜 로그인의 scope·provider 주소 같은 비밀 아닌 설정은 application.yml에 있으니 여기엔 비밀값만 둔다.
spring:
  datasource:
    driver-class-name: org.mariadb.jdbc.Driver
    url: jdbc:mariadb://localhost:3306/gain-z?useSSL=false&serverTimezone=Asia/Seoul
    username: gainz
    password: 비밀번호

  data:
    redis:
      host: localhost
      port: 6379

  security:
    oauth2:
      client:
        registration:
          google:
            client-id: 구글-클라이언트-ID
            client-secret: 구글-클라이언트-시크릿
          kakao:
            client-id: 카카오-REST-API-키
            client-secret: 카카오-클라이언트-시크릿
          naver:
            client-id: 네이버-클라이언트-ID
            client-secret: 네이버-클라이언트-시크릿

jwt:
  # HMAC-SHA256 서명 키. 32자(256비트) 이상
  secret: 32자-이상의-아무-문자열
